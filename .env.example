# VideoNova self-hosted settings
# No API token or third-party account is required.

HOST=127.0.0.1
PORT=8080

# Open-source model. The default downloader fetches this public model anonymously once,
# then generation runs from your local files.
VIDEONOVA_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
VIDEONOVA_MODEL_PATH=./models/Wan2.1-T2V-1.3B-Diffusers
VIDEONOVA_AUTO_DOWNLOAD=true

# Optional: cuda, mps, or cpu. Leave blank for automatic detection.
VIDEONOVA_DEVICE=
